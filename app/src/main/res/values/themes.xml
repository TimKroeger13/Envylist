<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Neidliste" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!-- Small transparent activities started from the widget (quick add, actions, objections). -->
    <style name="Theme.Neidliste.Dialog" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <!-- draw behind transparent system bars; otherwise Android paints a black status bar strip -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Quick add: no window animation, the input bar slides in itself and rides on the keyboard. -->
    <style name="Theme.Neidliste.Sheet" parent="Theme.Neidliste.Dialog">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
